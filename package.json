{
    "name":  "parcelpilot-ai-support",
    "version":  "1.0.0",
    "description":  "ParcelPilot AI Customer Support \u0026 Operations System",
    "main":  "backend/server.js",
    "type":  "module",
    "scripts":  {
                    "start":  "node backend/server.js",
                    "server":  "node backend/server.js",
                    "client":  "npm run dev --prefix frontend",
                    "dev":  "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"node backend/server.js\" \"npm run dev --prefix frontend\"",
                    "build":  "npm --prefix frontend install \u0026\u0026 npm --prefix frontend run build",
                    "test":  "node tests/backend.test.js"
                },
    "dependencies":  {
                         "better-sqlite3":  "^13.0.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^5.2.1",
                         "uuid":  "^10.0.0"
                     },
    "devDependencies":  {
                            "concurrently":  "^9.1.2"
                        }
}
